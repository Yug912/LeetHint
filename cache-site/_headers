# Cloudflare Pages headers. The extension fetches these files from its own
# pages (allowed by host_permissions); CORS is open so testing from anywhere works.
/*
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff

/cache/*
  Cache-Control: public, max-age=3600

/index.json
  Cache-Control: public, max-age=600

/companies.json
  Cache-Control: public, max-age=86400
