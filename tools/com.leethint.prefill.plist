<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Morning pre-fill on a Mac (tools/README.md → "Every morning").
     05:00 in the Mac's own time zone (IST). caffeinate -i keeps the Mac awake
     until the script ends. __ROOT__ is replaced by the repo path when installed. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.leethint.prefill</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>/bin/bash</string>
    <string>__ROOT__/tools/prefill-nightly.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__ROOT__/logs/launchd.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/logs/launchd.log</string>
</dict>
</plist>
